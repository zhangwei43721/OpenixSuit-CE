{
  "id": "v881-ab-ota",
  "name": "V881 A/B 分区升级",
  "version": "2.0.0",
  "description": "检查当前 A/B 槽位并将镜像安全写入非活动槽位，可在读回校验后重启。",
  "icon": "plugin://icon.svg",
  "permissions": ["devices.read", "adb.partition", "adb.reboot"],
  "settings": [],
  "actions": [
    {
      "id": "upgrade",
      "label": "升级非活动槽位",
      "description": "先检查当前槽位，再由宿主完成非活动槽位写入、读回校验和可选重启。",
      "inputs": [
        {"id":"slot_image","label":"升级分区镜像","type":"file","required":true,"description":"待写入的分区镜像文件"},
        {"id":"target_partition","label":"目标分区","type":"select","required":true,"default":"boot","options":["boot","rootfs","system"]},
        {"id":"auto_reboot","label":"校验后自动重启","type":"boolean","required":false,"default":true}
      ],
      "output": [{"id":"result","label":"写入结果","type":"json"}],
      "entry": {"kind":"javascript","file":"main.js","export":"upgrade"},
      "timeout_ms": 900000
    }
  ],
  "pages": [{"id":"upgrade","label":"A/B 升级","description":"把镜像写入当前未启动的分区槽位。","actions":["upgrade"]}],
  "providers": []
}
