{
  "id": "v881-app-push",
  "name": "V881 App 快推安装",
  "version": "2.0.0",
  "description": "把本地程序或应用包部署到 V881 指定目录，可按需提权并执行重启命令。",
  "icon": "plugin://icon.svg",
  "permissions": ["devices.read", "adb.transfer", "adb.root", "adb.shell"],
  "settings": [],
  "actions": [
    {
      "id": "deploy",
      "label": "推送应用",
      "description": "由宿主完成设备检查、目录准备、文件传输和可选重启命令。",
      "inputs": [
        {"id":"local_file","label":"本地应用文件","type":"file","required":true,"description":"待推送的二进制程序或安装包"},
        {"id":"remote_dir","label":"设备目标目录","type":"text","required":true,"default":"/usr/bin"},
        {"id":"remote_name","label":"设备端文件名","type":"text","required":true,"default":"v881_app"},
        {"id":"need_root","label":"先切换 adb root","type":"boolean","required":false,"default":true},
        {"id":"restart_cmd","label":"推送后执行命令","type":"text","required":false,"default":"","description":"可选，例如 /etc/init.d/app restart"}
      ],
      "output": [{"id":"result","label":"部署结果","type":"json"}],
      "entry": {"kind":"javascript","file":"main.js","export":"deploy"},
      "timeout_ms": 180000
    }
  ],
  "pages": [{"id":"deploy","label":"应用推送","actions":["deploy"]}],
  "providers": []
}
