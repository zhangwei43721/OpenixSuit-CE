{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenixSuit-CE",
  "version": "0.1.0",
  "identifier": "com.openixsuit.ce",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenixSuit-CE",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
